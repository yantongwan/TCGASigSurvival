\name{load_cptac_proteogenomic_results}
\alias{load_cptac_proteogenomic_results}
\title{Load CPTAC Proteogenomic Validation Results}
\usage{
load_cptac_proteogenomic_results(project_dir = getwd(), proteogenomics_dir = tcgasig_cptac_default_dir(project_dir), 
    target_gene = "STRAP", signature_name = "Treg", signature_genes = NULL, include_joint_tables = FALSE, 
    verbose = TRUE) 

}
\arguments{
\item{project_dir}{Project directory containing input and output folders.}
\item{proteogenomics_dir}{Directory containing separately generated CPTAC workflow outputs.}
\item{target_gene}{Human target-gene symbol.}
\item{signature_name}{Signature name used in labels and output filenames.}
\item{signature_genes}{Character vector of signature gene symbols.}
\item{include_joint_tables}{Whether to load patient-level CPTAC joint tables.}
\item{verbose}{Whether to print progress messages.}
}
\description{
Reads the CPTAC RNA-protein validation, signature association, survival, integration,
QC, and report-summary tables generated by the companion
\code{PanCancer_STRAP_Proteogenomics} workflow.
}
\details{
This function does not download CPTAC data and does not rerun the external
analysis. It reads already generated files. Use
\code{run_cptac_proteogenomic_validation(rerun = TRUE)} if the external
pipeline should be rerun first.

The returned CPTAC results are independent proteogenomic validation results.
TCGA-CPTAC integration is performed at cancer/effect-size level only. TCGA and
CPTAC patients are never joined by patient ID.
}
\value{
A list of class \code{tcgasig_cptac_proteogenomics} containing loaded result
tables, source-file metadata, interpretation notes, and optionally CPTAC
patient-level joint tables.
}
\examples{
\dontrun{
cptac <- load_cptac_proteogenomic_results(
  project_dir = "my_tcga_project"
)
print(cptac)
}
}
